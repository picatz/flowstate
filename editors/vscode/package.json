{
  "name": "flowstate-flowfile",
  "displayName": "Flowstate Flowfile",
  "description": "Language client for Flowfile: launches `flow lsp` and shells out to `flow validate/test/fix/run local`. Not published to any marketplace.",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "test": "npm run compile && node --test out/**/*.test.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "flowfile",
        "aliases": [
          "Flowfile"
        ],
        "filenames": [
          "Flowfile",
          "Flowfile.yaml"
        ],
        "filenamePatterns": [
          "**/workflow.yaml",
          "**/workflow.yml",
          "**/workflows/*.yaml",
          "**/*.test.yaml",
          "**/*.test.yml",
          "**/testdefaults.yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Flowstate",
      "properties": {
        "flowstate.path": {
          "type": "string",
          "default": "flow",
          "description": "Path to the flow binary. Ignored when set in workspace (.vscode) settings \u2014 a cloned repository must not choose what your editor executes.",
          "scope": "machine"
        },
        "flowstate.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for `flow lsp`, e.g. [\"--plugin-dir\", \"/path/to/plugins\"]. A plugin directory must be an absolute path: the language server starts in the opened workspace, so a relative one would name a directory inside whatever repository you have open. Ignored when set in workspace (.vscode) settings, for the same reason as flowstate.path.",
          "scope": "machine"
        },
        "flowstate.dap.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for `flow dap`, e.g. [\"--plugin-dir\", \"/path/to/plugins\"] or [\"--address\", \"localhost:7233\", \"--token-file\", \"/path/to/token\"] for an attach. A plugin directory must be an absolute path, and the adapter does not start in your workspace, so give every path here as an absolute one. A launch runs the workflow, so pass the same --egress-policy and --task-policy the worker uses. Ignored when set in workspace (.vscode) settings, for the same reason as flowstate.path.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "flowstate.validate",
        "title": "Flowstate: Validate Flowfile",
        "category": "Flowstate"
      },
      {
        "command": "flowstate.test",
        "title": "Flowstate: Test Flowfile",
        "category": "Flowstate"
      },
      {
        "command": "flowstate.fix",
        "title": "Flowstate: Fix Flowfile",
        "category": "Flowstate"
      },
      {
        "command": "flowstate.runLocal",
        "title": "Flowstate: Run Flowfile Locally",
        "category": "Flowstate"
      },
      {
        "command": "flowstate.restartLanguageServer",
        "title": "Flowstate: Restart Language Server",
        "category": "Flowstate"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flowstate.validate",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)"
        },
        {
          "command": "flowstate.test",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml"
        },
        {
          "command": "flowstate.fix",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)"
        },
        {
          "command": "flowstate.runLocal",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)"
        }
      ],
      "editor/context": [
        {
          "command": "flowstate.validate",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)",
          "group": "flowstate@1"
        },
        {
          "command": "flowstate.test",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml",
          "group": "flowstate@2"
        },
        {
          "command": "flowstate.fix",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)",
          "group": "flowstate@3"
        },
        {
          "command": "flowstate.runLocal",
          "when": "resourceLangId == flowfile && resourceFilename != testdefaults.yaml && !(resourceFilename =~ /\\.test\\.ya?ml$/)",
          "group": "flowstate@4"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "flowfile"
      }
    ],
    "debuggers": [
      {
        "type": "flowstate",
        "label": "Flowstate",
        "languages": [
          "flowfile"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The workflow to run locally.",
                "default": "${file}"
              },
              "inputs": {
                "type": "object",
                "description": "The run's inputs, keyed by the names the workflow declares under `inputs:`.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Hold the run at its first step. Set false to run to the first breakpoint, failure stop or pause.",
                "default": true
              },
              "revealSensitive": {
                "type": "boolean",
                "description": "Show the values of sensitive inputs and outputs while debugging.",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "workflowId"
            ],
            "properties": {
              "workflowId": {
                "type": "string",
                "description": "Workflow id of the durable run to attach to."
              },
              "runId": {
                "type": "string",
                "description": "First run id of the chain to pin; unset follows the current run."
              },
              "sessionId": {
                "type": "string",
                "description": "Rejoin a debug session another client left attached."
              },
              "program": {
                "type": "string",
                "description": "The Flowfile the run executes, used only to map lines; shown as step addresses when it is not byte for byte that file."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "flowstate",
            "request": "launch",
            "name": "Debug this Flowfile",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Flowstate: Debug a Flowfile",
            "description": "Run a workflow locally under the debugger.",
            "body": {
              "type": "flowstate",
              "request": "launch",
              "name": "Debug ${1:this Flowfile}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          },
          {
            "label": "Flowstate: Attach to a durable run",
            "description": "Debug a run on a server.",
            "body": {
              "type": "flowstate",
              "request": "attach",
              "name": "Attach to ${1:a durable run}",
              "workflowId": "${2:workflow-id}"
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/vscode": "1.138.0",
    "typescript": "7.0.2"
  }
}
