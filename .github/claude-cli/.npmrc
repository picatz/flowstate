# Exact versions in package.json, no caret ranges. A compromised patch release
# then cannot arrive without a commit to package-lock.json and package.json both
# changing — see CLAUDE.md and the supply-chain section of #585.
save-exact=true

# `postinstall`/`preinstall`/`install` scripts are arbitrary code execution at
# `npm ci` time, in CI, on the runner this workflow's own isolation notes
# argue must never touch a Go cache or a repository-write token (see
# editors.yml). It is the single most-used npm supply-chain vector — a
# compromised or typosquatted package does not need a `require()` anywhere in
# this extension's code path, only a lifecycle script in its own
# package.json. This dependency set (vscode-languageclient, typescript,
# @types/node, @types/vscode) has no legitimate reason to run one — none of
# them ship native addons or code-generation steps — so there is nothing this
# setting should ever need to bypass. If a future dependency genuinely needs
# an install script, that is a decision to make explicitly (an
# `allow-scripts`-style per-package exception, reviewed in the PR that adds
# it), not a reason to drop this default.
ignore-scripts=true
