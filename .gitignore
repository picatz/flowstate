# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# macOS
.DS_Store

# The compiled CLI, when built in place with `go build ./cmd/flow`.
/flow

# Plugin binaries, when built in place per a plugin's own README
# (`go build -o .../flowstate-plugin-<name> ./plugins/<name>`) rather than
# into a directory already outside the tree.
/plugins/*/flowstate-plugin-*
/plugins/*/bin/

# Agent worktrees. Worktree isolation for subagents materializes under
# .claude/worktrees/, which is scratch by definition: each is a copy of the
# tree mid-edit, and committing one would commit a snapshot of unfinished
# work twice over. Everything else under .claude/ (skills, commands) is
# checked in.
.claude/worktrees/

