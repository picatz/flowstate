{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go env)",
      "Bash(go version)",
      "Bash(go run ./tools/gate:*)",
      "Bash(go run ./tools/testsum:*)",
      "Bash(go run ./tools/shipcheck:*)",
      "Bash(go run ./cmd/flow validate:*)",
      "Bash(go run ./cmd/flow lint:*)",
      "Bash(make gate)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make test)",
      "Bash(make test-fast)",
      "Bash(make docs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch origin:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-env.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./tools/hooks/genguard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./tools/hooks/pidguard"
          },
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./tools/hooks/mergeguard"
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./tools/hooks/mergeguard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "go -C \"${CLAUDE_PROJECT_DIR}\" run ./tools/hooks/gofmtcheck"
          }
        ]
      }
    ]
  }
}
