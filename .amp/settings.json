{
  "amp.skills.disableClaudeCodeSkills": true,
  "amp.permissions": [
    {
      "tool": "Bash",
      "matches": {
        "cmd": [
          "*gh pr merge*",
          "*gh release create*",
          "*gh release edit*",
          "*gh release delete*",
          "*gh release upload*"
        ]
      },
      "action": "ask"
    },
    {
      "tool": "mcp__github__merge_pull_request",
      "action": "ask"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": [
          "*git*reset*--hard*",
          "*git*clean*-*f*",
          "*rm*-*r*f*",
          "*rm*-*f*r*",
          "*rm*-*R*f*",
          "*rm*-*f*R*"
        ]
      },
      "action": "ask"
    }
  ]
}
